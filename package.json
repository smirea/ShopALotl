{
	"name": "shopalotl",
	"private": true,
	"type": "module",
	"scripts": {
		"typecheck": "bun check",
		"test": "bun test server scripts",
		"build": "wrangler deploy --dry-run --outdir dist/worker",
		"start:server": "cd server && bun --watch --no-clear-screen dev.ts",
		"generate": "bun scripts/generate.ts",
		"env:generate": "env-manager gen --local",
		"env:ios": "bun scripts/secrets.ts ios",
		"secrets:push": "bun scripts/secrets.ts push",
		"secrets:github": "bun scripts/secrets.ts github",
		"secrets:check": "bun scripts/secrets.ts check"
	},
	"packageManager": "bun@1.4.4",
	"dependencies": {
		"drizzle-orm": "^0.45.4",
		"sync-engine": "github:smirea/sync-engine",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261114.1",
		"@types/bun": "^1.4.4",
		"env-manager": "github:smirea/env-manager",
		"typescript": "^7.0.2",
		"wrangler": "^4.162.0"
	},
	"trustedDependencies": []
}
