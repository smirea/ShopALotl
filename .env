# env-manager: shopalotl
# env-manager target: Config format=swift path=LocalSecrets.xcconfig
# env-manager target: server format=ts path=.env.local generate=env.ts

# env-manager targets: Config,server
# The local server in dev, https://shopalotl.stf.lol in prod. Simulator and Mac Debug builds use dev's; device and
# Release builds bundle prod's through `bun run env:ios` (Config/Base.xcconfig).
API_URL=http://127.0.0.1:6191 # {url}

# env-manager targets: server
API_PORT=6191 # {int:min(1),max(65535)}
# `production` in env-manager prod, `development` in dev. server/config.ts requires production's secrets.
APP_ENV=development # {string:format(/^(development|production)$/)}
# The one credential: the app sends it as a bearer on every request. Empty in dev, where every local server takes
# the development token. Required in production.
OWNER_TOKEN= # {optional string}
# GitHub token of the smirea-ai account (`gh auth token --user smirea-ai`), which can write to smirea/ShopALotl. Files
# the Feedback editor's posts to /api/feedback as issues. Required in production.
GITHUB_TOKEN= # {optional string}
# Deploy credentials, shared with procrastimate's and a-better-me's Cloudflare account. `scripts/secrets.ts` hands
# them to wrangler; they are never Worker bindings.
CLOUDFLARE_ACCOUNT_ID= # {optional string}
CLOUDFLARE_API_TOKEN= # {optional string}
# App Store Connect team API key (Admin role, shared with procrastimate and a-better-me). `scripts/archive` signs the
# TestFlight export and uploads with it. ASC_PRIVATE_KEY_B64 is the AuthKey_<id>.p8 base64 on one line.
ASC_KEY_ID= # {optional string}
ASC_ISSUER_ID= # {optional string}
ASC_PRIVATE_KEY_B64= # {optional string}
