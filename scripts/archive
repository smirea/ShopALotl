#!/usr/bin/env bash
# Archives the Release app and uploads it to App Store Connect (TestFlight) with an App Store Connect API key.
# Usage: ./scripts/archive [--export-only]
# Needs ASC_KEY_ID, ASC_ISSUER_ID, and ASC_KEY_PATH (the AuthKey_<id>.p8 file, kept outside the repo). On this Mac,
# `bun run testflight` supplies them from env-manager prod. Release's API_URL and OWNER_TOKEN come from
# `bun run env:ios`: env-manager prod locally, the process environment in CI.
# BUILD_NUMBER overrides the build number, which defaults to the current UTC time as year.MMdd.HHmmss: always higher,
# and within CFBundleVersion's three period-separated integers with a first integer of at most four digits.
set -euo pipefail
cd "$(dirname "$0")/.."

team=FNYFHG5SV7
destination=upload
case "${1:-}" in
    "") ;;
    --export-only) destination=export ;;
    *) echo "usage: $0 [--export-only]" >&2; exit 64 ;;
esac

: "${ASC_KEY_ID:?Set ASC_KEY_ID to the App Store Connect API key id}"
: "${ASC_ISSUER_ID:?Set ASC_ISSUER_ID to the App Store Connect issuer id}"
: "${ASC_KEY_PATH:?Set ASC_KEY_PATH to the AuthKey_<id>.p8 path}"
test -f "$ASC_KEY_PATH" || { echo "No key at $ASC_KEY_PATH" >&2; exit 1; }
key_path=$(cd "$(dirname "$ASC_KEY_PATH")" && pwd -P)/$(basename "$ASC_KEY_PATH")
case "$key_path" in
    "$(pwd -P)"/*) echo "Keep the API key outside the repository: $key_path" >&2; exit 1 ;;
esac

read -r year monthday time < <(date -u '+%Y %m%d %H%M%S')
build_number=${BUILD_NUMBER:-$year.$((10#$monthday)).$((10#$time))}
out=DerivedData/archive
archive=$out/App.xcarchive
options=$out/ExportOptions.plist
entitlements=$out/App.entitlements

rm -rf "$out"
mkdir -p "$out"
cat > "$options" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>method</key>
    <string>app-store-connect</string>
    <key>destination</key>
    <string>$destination</string>
    <key>teamID</key>
    <string>$team</string>
    <key>signingStyle</key>
    <string>automatic</string>
    <key>manageAppVersionAndBuildNumber</key>
    <false/>
</dict>
</plist>
PLIST

bun run env:ios

bun scripts/own-packages.ts DerivedData/SourcePackages

echo "Archiving build $build_number"
# Unsigned archive: automatic signing here asks for an Apple Development certificate, and each fresh CI runner would
# mint another "Created via API" one until the account hits its cap, as procrastimate found. Export signs the app with
# Apple Distribution.
xcodebuild archive -project App.xcodeproj -scheme App -configuration Release \
    -destination 'generic/platform=iOS' -archivePath "$archive" \
    -clonedSourcePackagesDirPath DerivedData/SourcePackages \
    CURRENT_PROJECT_VERSION="$build_number" \
    CODE_SIGNING_ALLOWED=NO \
    CODE_SIGNING_REQUIRED=NO \
    CODE_SIGN_IDENTITY=""

# Export keeps only the entitlements a bundle is already signed with, so an unsigned archive would ship without the
# keychain group ProcrastiMate shares its session through, or the app group the widget reads the database from.
# Ad-hoc signing with the entitlements carries them through. Xcode fills in $(AppIdentifierPrefix) only when it signs,
# so this does. The widget is signed before the app, whose signature seals it.
app=$archive/Products/Applications/App.app
widget=$app/PlugIns/Widget.appex
test -d "$widget" || { echo "No widget extension in $app" >&2; exit 1; }
expand() {
    sed "s/\$(AppIdentifierPrefix)/$team./g" "$1" > "$2"
    if grep -q '\$(' "$2"; then echo "Unexpanded build setting in $1" >&2; exit 1; fi
}
expand Config/App.entitlements "$entitlements"
expand Config/Widget.entitlements "$out/Widget.entitlements"
codesign --force --deep --sign - "$app"
codesign --force --sign - --entitlements "$out/Widget.entitlements" "$widget"
codesign --force --sign - --entitlements "$entitlements" "$app"

xcodebuild -exportArchive -archivePath "$archive" -exportOptionsPlist "$options" -exportPath "$out/export" \
    -allowProvisioningUpdates \
    -authenticationKeyPath "$key_path" \
    -authenticationKeyID "$ASC_KEY_ID" \
    -authenticationKeyIssuerID "$ASC_ISSUER_ID"

if [ "$destination" = upload ]; then
    [ -z "${GITHUB_OUTPUT:-}" ] || echo "build-number=$build_number" >> "$GITHUB_OUTPUT"
    echo "Uploaded build $build_number. It shows in TestFlight once App Store Connect finishes processing."
else
    echo "Exported $out/export/App.ipa (build $build_number)"
fi
